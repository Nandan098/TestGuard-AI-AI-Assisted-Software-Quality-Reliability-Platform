# Backend API's target service URL. For local development:
TARGET_BASE_URL=http://127.0.0.1:8001
DATABASE_URL=sqlite:///./testguard.db
REQUEST_TIMEOUT_SECONDS=4
PERFORMANCE_BUDGET_MS=1000

# Optional fault injection for the demo target API (configured where target app runs):
DEMO_BUG_MODE=false
DEMO_LATENCY_MS=0
